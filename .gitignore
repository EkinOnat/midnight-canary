# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Contract artifacts.
# NOTE: the root `managed/` directory IS committed on purpose — the compiled
# circuits and verifier keys are part of what this project ships.
contracts/managed/

# Deployment info
deployment.json

# Wallet seed (sensitive)

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/settings.json
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses).
# Contains the wallet SEED — never commit this, including any backup copies.
.midnight-state.json
.midnight-state.*.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

# Local private-state store. Holds responders' secret keys and scores —
# this is exactly the data the contract is designed to keep off-chain.
midnight-level-db/
