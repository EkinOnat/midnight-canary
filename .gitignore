# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
*.tsbuildinfo

# Environment variables. `.env.local` also holds the Vercel OIDC token, so the
# glob is deliberately broad — but `.env.example` documents the settings and is
# meant to be committed.
.env*
!.env.example

# Contract artifacts.
# NOTE: the root `managed/` directory IS committed on purpose — the compiled
# circuits and verifier keys are part of what this project ships.
contracts/managed/

# Staged copy of the ZK artifacts for the browser. Generated from managed/ by
# scripts/copy-zk-assets.js on every dev/build — committing it would duplicate
# 5.6 MB of binaries.
public/managed/

# Deployment info
deployment.json

# Wallet seed (sensitive)

# OS generated files
.DS_Store
Thumbs.db

# IDE / agent tooling
.vscode/settings.json
.idea/
.claude/
*.swp
*.swo

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage/

# Private state
*-state/

# Temporary files
tmp/
temp/

# Midnight network state (per-network seeds, deploy addresses).
# Contains the wallet SEED — never commit this, including any backup copies.
.midnight-state.json
.midnight-state.*.json

# Midnight wallet sync state (per-network serialized wallet state cache)
.midnight-wallet-state/

# Local private-state store. Holds responders' secret keys and scores —
# this is exactly the data the contract is designed to keep off-chain.
midnight-level-db/

# Vercel project link and the OIDC token it downloads
.vercel
