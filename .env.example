# Copy to `.env` for local development, or set these in your host's dashboard
# (`npx vercel env add ...`) for the deployed site.
#
# Both values have working defaults in src/config.ts, so a fresh clone runs
# against the live Preview deployment without any of this. Set them to point at
# your own contract.
#
# Which Midnight network the dApp targets. The wallet is asked to connect to
# this network, and the connection is rejected if the wallet reports a
# different one.
#
# Preview, not Preprod: Preprod's RPC and faucet are down as of 2026-08-03 and
# Midnight directed builders to Preview.
VITE_MIDNIGHT_NETWORK=preview

# The deployed Canary contract on that network. Printed by
# `npm run deploy -- --network preview` and stored in .midnight-state.json.
VITE_CONTRACT_ADDRESS=713e14035854aee952c8f2c56f2b871f14f1ce8a8b59d2fa96e51f9d2204bbc8

# Optional. Encrypts the local private-state store (the responder's identity
# secret) at rest in the browser. Must be at least 16 characters. Leave empty
# and the app mints a random per-browser password instead, which is stronger
# than anything that could be committed here.
VITE_PRIVATE_STATE_PASSWORD=
